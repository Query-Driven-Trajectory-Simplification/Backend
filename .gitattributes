* text=auto

# Force LF on checkout 
*.sh    text eol=lf
*.py    text eol=lf
Makefile text eol=lf
*.mk    text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.ld    text eol=lf
*.ninja text eol=lf

# Source files:
*.c     text
*.h     text
*.cpp   text
*.hpp   text
*.cc    text
*.S     text
*.md    text
*.json  text
*.yaml  text
*.yml   text

# Windows-only scripts need CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files: never touch
*.png   binary
*.jpg   binary
*.zip   binary
*.bin   binary
*.elf   binary
*.a     binary
*.o     binary
*.px4   binary